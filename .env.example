# ── CÉU environment ─────────────────────────────────────────────
# Nothing is required to run the app: Open-Meteo needs no API key.

# Development only: serve clearly-labelled SYNTHETIC data instead of calling
# Open-Meteo (useful offline). Ignored on Vercel production deployments.
# CEU_FIXTURES=1

# Accuracy foundation (optional). Server-side only — never prefix with NEXT_PUBLIC_.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for GET /api/cron/snapshot (sent as "Authorization: Bearer <secret>").
# CRON_SECRET=
